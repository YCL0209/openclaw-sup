# Clawdbot + ERP Integration Environment Variables
# Copy this file to .env and fill in your actual values

# ========================================
# ERP API Configuration
# ========================================

# ERP Server Base URL
ERP_API_URL=http://localhost:3000

# Your Company Tax ID (統一編號 - 8 digits)
ERP_TAX_ID=12345678

# Bot Account Email (created in ERP)
ERP_BOT_EMAIL=bot@yourcompany.com

# Bot Account Password (use strong password)
ERP_BOT_PASSWORD=your-secure-password-min-6-chars

# ========================================
# Token Management (Optional)
# ========================================

# How often to refresh token (seconds)
ERP_TOKEN_REFRESH_INTERVAL=3600

# Buffer before token expiry to refresh (seconds)
ERP_TOKEN_EXPIRY_BUFFER=300

# ========================================
# Features (Optional)
# ========================================

# Automatically create new customer if not found
AUTO_CREATE_CUSTOMER=true

# Require user confirmation before creating order
CONFIRM_BEFORE_CREATE=true

# Send notification after order creation
SEND_NOTIFICATION=true

# ========================================
# Logging (Optional)
# ========================================

# Log level: debug, info, warn, error
LOG_LEVEL=info

# Log file path (leave empty to disable file logging)
LOG_FILE=~/.clawdbot/logs/erp-integration.log
